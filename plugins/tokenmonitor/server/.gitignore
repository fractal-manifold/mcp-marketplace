# Build artifacts resolved on-demand into ~/.cache/tokenmonitor/ — never
# committed. NOTE: do NOT add a bare `tokenmonitor-mcp` rule here; `server/tokenmonitor-mcp` is the
# tracked launcher. The Go binaries below live under go/ and don't collide.
js/node_modules/
py/.venv/
py/venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/
go/tokenmonitor-mcp
go/tokenmonitor-mcp-go

# Prebuilt Go binaries: built by `make -C go release-bins` into bin/ and
# UPLOADED to the broker GitHub release — the launcher fetches them on demand
# for toolchain-free hosts (see docs/releasing.md). Only bin/SHA256SUMS is
# tracked in git (the trust root the launcher verifies downloads against); the
# multi-megabyte binaries themselves are never committed.
bin/tokenmonitor-mcp-go-*
