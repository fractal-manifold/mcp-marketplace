#!/bin/sh
# tokenmonitor-mcp launcher — picks one of the tokenmonitor-mcp implementations (Go,
# Python, JS) and execs it. Runs from Claude Code's MCP stdio plumbing,
# so:
#   - stdin/stdout must be pristine for the JSON-RPC peer; only stderr
#     can be used for diagnostics.
#   - the launcher MUST `exec` (no extra layers of shell) once it picks,
#     so signal handling and stdio pipes belong to the chosen impl, not
#     to this wrapper.
#
# Two modes, auto-detected from where this script lives:
#
#   BUNDLE MODE — the launcher sits inside the plugin next to packaged
#   runtime source (`js/`, `py/`, `go/`), a `compat/` dir and a `VERSION`
#   file. Used when the tokenmonitor plugin ships its own server. Nothing
#   is expected on PATH except the language toolchain (node+npm, python3
#   +uv/pip, or go). On first run the launcher resolves the first usable
#   runtime ON DEMAND into a per-user, per-version cache
#   (~/.cache/tokenmonitor/<version>/<rt>/): npm install / venv +
#   pip / go build. Subsequent runs are a cache hit. Heavy deps (incl.
#   native modules) are therefore built for the host, never committed.
#
#   PATH MODE — the launcher was installed standalone (e.g. to
#   ~/.local/bin via install.sh). It looks for tokenmonitor-mcp-go / tokenmonitor-mcp-py /
#   tokenmonitor-mcp-js already on PATH and execs the first that passes --probe.
#
# Selection in both modes:
#   1. Read $XDG_CONFIG_HOME/tokenmonitor/launcher.conf (or
#      ~/.config/tokenmonitor/launcher.conf). Format:
#          runtime=auto|go|python|js
#      Missing file or invalid value -> "auto".
#   2. Order candidates: preferred first (when not auto), then the rest.
#      Bundle-mode default order is js -> python -> go (JS/Python need no
#      compile step); PATH-mode default stays go -> python -> js.
#
# POSIX sh, no bashisms. Tested with dash + zsh.
set -u

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tokenmonitor"
conf_file="$config_dir/launcher.conf"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/tokenmonitor"

# Resolve the directory this launcher lives in (physical, no symlinks),
# so bundle detection and the packaged runtimes resolve correctly even
# when invoked through a symlink.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

runtime="auto"
if [ -r "$conf_file" ]; then
    # Source as shell so values like runtime=go don't need quotes. The
    # file is user-owned and never world-writable in practice, but if
    # the user has weird values we ignore them.
    # shellcheck disable=SC1090
    . "$conf_file" 2>/dev/null || true
fi
case "$runtime" in
    auto|go|python|js) : ;;
    *) runtime=auto ;;
esac

log() { printf 'tokenmonitor-mcp launcher: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Bundle mode
# ---------------------------------------------------------------------------

# Bundle mode when this launcher sits next to the packaged runtimes.
is_bundle=0
if [ -f "$script_dir/VERSION" ] && [ -d "$script_dir/compat" ] && \
   { [ -d "$script_dir/js" ] || [ -d "$script_dir/py" ] || [ -d "$script_dir/go" ]; }; then
    is_bundle=1
fi

bundle_version() { cat "$script_dir/VERSION" 2>/dev/null || echo dev; }

# mkdir-based lock (atomic, POSIX). Serializes concurrent first-run
# setups across multiple Claude Code sessions sharing the cache. The
# holder writes its PID into <lock>/pid; a contender STEALS the lock
# (removes it and retries) when that PID names a dead process or the
# lockdir has been abandoned for >10 min, so a setup killed mid-flight
# can't wedge every future session behind the old rmdir-only cleanup.
TMON_HELD_LOCK=""

# release_lock <dir>: remove the lock (now a dir containing a pid file)
# and clear the held-lock marker if it was ours. Guards an empty arg so
# the global EXIT trap is a no-op once we released explicitly / never
# acquired.
release_lock() {
    [ -n "${1:-}" ] || return 0
    rm -rf "$1" 2>/dev/null || true
    [ "$1" = "$TMON_HELD_LOCK" ] && TMON_HELD_LOCK=""
    return 0
}

# One global trap: on any exit release whatever lock we currently hold.
# (The success paths exec the runtime and release explicitly first, so
# this only fires when a setup dies before releasing.)
trap 'release_lock "$TMON_HELD_LOCK"' EXIT INT TERM

acquire_lock() {
    _lock="$1"
    _tries=0
    while ! mkdir "$_lock" 2>/dev/null; do
        # Contention. Steal the lock if its holder is gone (dead PID) or
        # the lockdir is stale (>10 min), then retry immediately.
        _steal=0
        _lpid=$(cat "$_lock/pid" 2>/dev/null || true)
        if [ -n "$_lpid" ]; then
            kill -0 "$_lpid" 2>/dev/null || _steal=1
        fi
        if [ "$_steal" -eq 0 ] && \
           [ -n "$(find "$_lock" -maxdepth 0 -mmin +10 -print 2>/dev/null)" ]; then
            _steal=1
        fi
        if [ "$_steal" -eq 1 ]; then
            log "stealing stale lock $_lock (holder pid='${_lpid:-?}')"
            rm -rf "$_lock" 2>/dev/null || true
            continue
        fi
        _tries=$((_tries + 1))
        if [ "$_tries" -gt 600 ]; then
            log "timed out waiting for lock $_lock"
            return 1
        fi
        sleep 1
    done
    printf '%s' "$$" > "$_lock/pid"
    TMON_HELD_LOCK="$_lock"
    return 0
}

# Copy the version-pinned shared files (VERSION + compat/) into the cache
# so the runtimes' upward "find ../compat / find ../VERSION" walks resolve
# without touching impl code. Refresh (not just create) when the bundled
# source is newer than the cached copy: a re-vendored contract under the
# SAME VERSION must not leave a stale schema behind. A marker file tracks
# the last mirror time so we can cheaply detect a newer source.
mirror_common() {
    _verdir="$1"
    _marker="$_verdir/.mirror_marker"
    mkdir -p "$_verdir"
    _stale=0
    [ -e "$_verdir/VERSION" ] || _stale=1
    [ -d "$_verdir/compat" ]  || _stale=1
    if [ -f "$_marker" ]; then
        [ -n "$(find "$script_dir/VERSION" -newer "$_marker" -print 2>/dev/null | head -n 1)" ] && _stale=1
        [ -n "$(find "$script_dir/compat" -newer "$_marker" -print 2>/dev/null | head -n 1)" ] && _stale=1
    else
        _stale=1
    fi
    if [ "$_stale" -eq 1 ]; then
        cp -f "$script_dir/VERSION" "$_verdir/VERSION"
        rm -rf "$_verdir/compat"
        cp -R "$script_dir/compat" "$_verdir/compat"
        : > "$_marker"
    fi
}

# needs_setup <ready-marker> <bundle-source-dir>: true (exit 0) when the
# cache must be (re)built — marker missing, or any bundled source file is
# newer than the marker. The cache is keyed by VERSION, but this also
# refreshes it when the bundled source changes WITHOUT a version bump
# (e.g. local iteration), so a regenerated bundle never runs stale code.
# The shared contract (VERSION + compat/) is mirrored into the cache too,
# so a change to either of those must also force a rebuild — otherwise a
# re-vendored contract would leave the runtime serving a stale schema.
needs_setup() {
    [ -f "$1" ] || return 0
    [ -n "$(find "$2" -newer "$1" -print 2>/dev/null | head -n 1)" ] && return 0
    [ -n "$(find "$script_dir/VERSION" -newer "$1" -print 2>/dev/null | head -n 1)" ] && return 0
    [ -n "$(find "$script_dir/compat" -newer "$1" -print 2>/dev/null | head -n 1)" ] && return 0
    return 1
}

# Each ensure_* returns non-zero (without execing) when its toolchain is
# missing or setup fails, so the caller can fall through to the next
# candidate. On success it `exec`s and never returns.

ensure_js() {
    command -v node >/dev/null 2>&1 || { log "js: node not found"; return 1; }
    command -v npm  >/dev/null 2>&1 || { log "js: npm not found";  return 1; }
    _verdir="$cache_root/$(bundle_version)"
    _rt="$_verdir/js"
    _ready="$_rt/.tmon-ready"
    _js_unavail="$_verdir/.js-unavailable"
    mkdir -p "$_verdir"
    # Skip js fast if a prior run already proved this version's native deps
    # can't be built here (e.g. fs-ext won't compile on a very new node ABI):
    # no point re-running npm install on every spawn just to fall through
    # again. The marker is per-version, so a version bump re-attempts js.
    if [ -f "$_js_unavail" ] && [ ! -f "$_ready" ]; then
        log "js: skipped (native deps unbuildable for this version; using another runtime)"
        return 1
    fi
    if needs_setup "$_ready" "$script_dir/js"; then
        acquire_lock "$_verdir/.lock-js" || return 1
        if needs_setup "$_ready" "$script_dir/js"; then
            mirror_common "$_verdir"
            rm -rf "$_rt"
            cp -R "$script_dir/js" "$_rt"
            log "installing JS deps (first run, ~once per version) in $_rt"
            if ( cd "$_rt" && npm install --omit=dev --no-audit --no-fund --loglevel=error ) 1>&2; then
                # fs-ext is a native module (flock(2)); per-device auth is
                # DISABLED without its compiled .node — and every device on a
                # per-device PSK then fails with "bad signature". On very new
                # node ABIs `npm install` can leave it uncompiled without
                # failing, so verify and explicitly rebuild.
                if [ ! -f "$_rt/node_modules/fs-ext/build/Release/fs_ext.node" ]; then
                    log "js: fs-ext native module not built; rebuilding (required for per-device auth)"
                    ( cd "$_rt" && npm rebuild fs-ext --loglevel=error ) 1>&2 || true
                fi
                if [ ! -f "$_rt/node_modules/fs-ext/build/Release/fs_ext.node" ]; then
                    : > "$_js_unavail"
                    release_lock "$_verdir/.lock-js"
                    log "js: fs-ext failed to build — per-device auth unavailable; falling back to another runtime"
                    return 1
                fi
                rm -f "$_js_unavail"
                : > "$_ready"
            else
                release_lock "$_verdir/.lock-js"
                log "js: npm install failed"
                return 1
            fi
        fi
        release_lock "$_verdir/.lock-js"
    fi
    log "using js ($_rt)"
    exec node "$_rt/src/index.js" "$@"
}

ensure_py() {
    command -v python3 >/dev/null 2>&1 || { log "python: python3 not found"; return 1; }
    _verdir="$cache_root/$(bundle_version)"
    _rt="$_verdir/py"
    _venv="$_rt/.venv"
    _ready="$_rt/.tmon-ready"
    mkdir -p "$_verdir"
    if needs_setup "$_ready" "$script_dir/py"; then
        acquire_lock "$_verdir/.lock-py" || return 1
        if needs_setup "$_ready" "$script_dir/py"; then
            mirror_common "$_verdir"
            rm -rf "$_rt"
            cp -R "$script_dir/py" "$_rt"
            log "installing Python deps (first run, ~once per version) in $_venv"
            _ok=1
            if command -v uv >/dev/null 2>&1; then
                uv venv "$_venv" 1>&2 \
                    && uv pip install --python "$_venv/bin/python" -e "$_rt" 1>&2 \
                    || _ok=0
            else
                python3 -m venv "$_venv" 1>&2 \
                    && "$_venv/bin/pip" install --disable-pip-version-check -e "$_rt" 1>&2 \
                    || _ok=0
            fi
            if [ "$_ok" -eq 1 ]; then
                : > "$_ready"
            else
                release_lock "$_verdir/.lock-py"
                log "python: dependency install failed"
                return 1
            fi
        fi
        release_lock "$_verdir/.lock-py"
    fi
    log "using python ($_rt)"
    exec "$_venv/bin/python" -m tmon_mcp "$@"
}

ensure_go() {
    _verdir="$cache_root/$(bundle_version)"
    _rt="$_verdir/go"
    # Windows executables need the .exe suffix both for the local `go build -o`
    # target and for the fetched asset — an extensionless PE won't launch.
    _exe=""
    case "$(detect_platform)" in windows-*) _exe=".exe" ;; esac
    _bin="$_rt/tokenmonitor-mcp-go$_exe"
    _ready="$_rt/.tmon-ready"
    # Fresh cached binary -> run it.
    if [ -x "$_bin" ] && ! needs_setup "$_ready" "$script_dir/go"; then
        log "using go ($_bin)"
        exec "$_bin" "$@"
    fi
    if ! command -v go >/dev/null 2>&1; then
        # No toolchain to build from source. Fetch a prebuilt binary on demand
        # (verified against the committed bin/SHA256SUMS) into the same cache
        # slot the local build would use, then run it. This is the toolchain-
        # free path; a host WITH go never reaches it (it builds above).
        if fetch_prebuilt_go "$_verdir" "$_rt" "$_bin"; then
            log "using prebuilt go ($_bin)"
            exec "$_bin" "$@"
        fi
        # Fetch unavailable/failed. A stale-but-present binary still beats
        # falling through to no runtime at all.
        if [ -x "$_bin" ]; then
            log "go: no toolchain and prebuilt fetch failed; using cached binary (may be stale)"
            exec "$_bin" "$@"
        fi
        log "go: no toolchain, and could not fetch a prebuilt binary"
        return 1
    fi
    mkdir -p "$_verdir"
    acquire_lock "$_verdir/.lock-go" || return 1
    if [ ! -x "$_bin" ] || needs_setup "$_ready" "$script_dir/go"; then
        mirror_common "$_verdir"
        rm -rf "$_rt"
        cp -R "$script_dir/go" "$_rt"
        log "compiling Go impl (first run, ~once per version) in $_rt"
        if ( cd "$_rt" && CGO_ENABLED=0 go build -trimpath \
                 -ldflags="-s -w -X main.Version=$(bundle_version)" \
                 -o "tokenmonitor-mcp-go$_exe" ./cmd/tokenmonitor-mcp ) 1>&2; then
            : > "$_ready"
        else
            release_lock "$_verdir/.lock-go"
            log "go: build failed"
            return 1
        fi
    fi
    release_lock "$_verdir/.lock-go"
    log "using go ($_bin)"
    exec "$_bin" "$@"
}

# ---------------------------------------------------------------------------
# Prebuilt Go binary (fetch-on-demand, no-toolchain fallback)
# ---------------------------------------------------------------------------
#
# The plugin ships the Go SOURCE (built locally by ensure_go when `go` is on
# PATH). When there is NO Go toolchain to compile with, ensure_go instead
# downloads a prebuilt, statically-linked binary for this host from the broker
# release, verifies it against the committed bin/SHA256SUMS, caches it in the
# same slot a local build would use, and runs it. So: `go` present -> build
# from source (no download); `go` absent -> fetch (no toolchain). Either way
# no scripting runtime / native-module install is needed.
#
# The device never phones home regardless; this is a one-time install-step
# download on the user's machine, exactly like the npm/pip/go paths already do
# — but toolchain-free. Base URL is overridable via TMON_PREBUILT_BASE_URL
# (tests / mirrors / air-gapped internal hosts).
#
# POSIX sh: no `local`; helpers use dp_/vp_/fp_ prefixes so they can't clobber
# the ensure_* vars (_bin/_rt/_verdir/...).

prebuilt_base_url() {
    if [ -n "${TMON_PREBUILT_BASE_URL:-}" ]; then
        printf '%s' "${TMON_PREBUILT_BASE_URL%/}"
    else
        printf 'https://github.com/fractal-manifold/mcp-marketplace/releases/download/broker-v%s' \
            "$(bundle_version)"
    fi
}

# detect_platform: echo "<os>-<arch>" for the running host, matching the names
# build-prebuilt.sh produces; empty when unrecognised (-> no fetch).
detect_platform() {
    dp_os="" ; dp_arch=""
    case "$(uname -s 2>/dev/null)" in
        Linux*)                          dp_os=linux ;;
        Darwin*)                         dp_os=darwin ;;
        MINGW*|MSYS*|CYGWIN*|Windows_NT) dp_os=windows ;;
    esac
    case "$(uname -m 2>/dev/null)" in
        x86_64|amd64)  dp_arch=amd64 ;;
        aarch64|arm64) dp_arch=arm64 ;;
    esac
    [ -n "$dp_os" ] && [ -n "$dp_arch" ] && printf '%s-%s' "$dp_os" "$dp_arch"
}

# verify_prebuilt <file> <basename>: check <file>'s SHA-256 against the entry
# for <basename> in bin/SHA256SUMS. FAIL-CLOSED (returns 1) on mismatch,
# missing/unreadable SHA256SUMS, no matching entry, OR no sha256 tool — we
# never exec downloaded content we couldn't verify. bin/SHA256SUMS ships in
# git, so the trust root is the checkout, not the downloaded blob.
verify_prebuilt() {
    vp_file="$1" ; vp_name="$2"
    vp_sums="$script_dir/bin/SHA256SUMS"
    [ -r "$vp_sums" ] || { log "prebuilt: no SHA256SUMS to verify against"; return 1; }
    # Exact basename match on field 2; its hash is field 1.
    vp_want=$(awk -v n="$vp_name" '$2==n {print $1; exit}' "$vp_sums" 2>/dev/null)
    [ -n "$vp_want" ] || { log "prebuilt: $vp_name not listed in SHA256SUMS"; return 1; }
    if command -v sha256sum >/dev/null 2>&1; then
        vp_got=$(sha256sum "$vp_file" 2>/dev/null | awk '{print $1; exit}')
    elif command -v shasum >/dev/null 2>&1; then
        vp_got=$(shasum -a 256 "$vp_file" 2>/dev/null | awk '{print $1; exit}')
    else
        log "prebuilt: no sha256sum/shasum to verify the download; refusing"
        return 1
    fi
    [ "$vp_got" = "$vp_want" ] && return 0
    log "prebuilt: checksum mismatch for $vp_name (got '${vp_got:-?}')"
    return 1
}

# fetch_prebuilt_go <verdir> <rt> <bin>: download the prebuilt Go binary for
# this host into <bin> (verified), mark it ready, and return 0 so the caller
# execs it. Returns 1 on: unknown platform / no downloader / download failure /
# checksum failure / no SHA256SUMS. Serialised with the same cache lock the
# local build uses, so concurrent sessions don't double-download.
fetch_prebuilt_go() {
    fp_verdir="$1" ; fp_rt="$2" ; fp_bin="$3"
    fp_plat=$(detect_platform)
    [ -n "$fp_plat" ] || { log "prebuilt: unrecognised platform; cannot fetch"; return 1; }
    fp_name="tokenmonitor-mcp-go-$fp_plat"
    case "$fp_plat" in windows-*) fp_name="$fp_name.exe" ;; esac

    if command -v curl >/dev/null 2>&1; then
        fp_dl='curl -fsSL -o'
    elif command -v wget >/dev/null 2>&1; then
        fp_dl='wget -qO'
    else
        log "prebuilt: neither curl nor wget on PATH; cannot fetch $fp_name"
        return 1
    fi

    mkdir -p "$fp_verdir"
    acquire_lock "$fp_verdir/.lock-go" || return 1
    # Another session may have fetched/built it while we waited on the lock.
    if [ -x "$fp_bin" ]; then
        release_lock "$fp_verdir/.lock-go"
        return 0
    fi
    mirror_common "$fp_verdir"
    mkdir -p "$fp_rt"
    fp_url="$(prebuilt_base_url)/$fp_name"
    fp_tmp="$fp_rt/.dl.$$"
    log "fetching prebuilt Go binary $fp_name (v$(bundle_version)) from $fp_url"
    if ! $fp_dl "$fp_tmp" "$fp_url" 1>&2; then
        rm -f "$fp_tmp"
        release_lock "$fp_verdir/.lock-go"
        log "prebuilt: download failed"
        return 1
    fi
    if ! verify_prebuilt "$fp_tmp" "$fp_name"; then
        rm -f "$fp_tmp"
        release_lock "$fp_verdir/.lock-go"
        return 1
    fi
    chmod +x "$fp_tmp" 2>/dev/null || true
    # Guard the install: a failed mv (e.g. replacing an in-use .exe on Windows)
    # must NOT leave us reporting success and exec'ing a missing/old target.
    if ! mv "$fp_tmp" "$fp_bin"; then
        rm -f "$fp_tmp"
        release_lock "$fp_verdir/.lock-go"
        log "prebuilt: could not install downloaded binary to $fp_bin"
        return 1
    fi
    : > "$fp_rt/.tmon-ready"
    release_lock "$fp_verdir/.lock-go"
    return 0
}

bundle_run() {
    case "$runtime" in
        auto|js) order="js python go" ;;
        python)  order="python js go" ;;
        go)      order="go js python" ;;
    esac
    for impl in $order; do
        case "$impl" in
            js)     ensure_js "$@" ;;
            python) ensure_py "$@" ;;
            go)     ensure_go "$@" ;;
        esac
        # Reaching here means ensure_* returned without exec -> try next.
    done
    printf '%s\n' \
        "tokenmonitor-mcp launcher: no runtime could be prepared (tried:$order)." \
        "" \
        "The bundled server resolves itself on first run. It needs EITHER a" \
        "toolchain on PATH to build/install from the bundled source:" \
        "  Node:    node (>=20) + npm" \
        "  Python:  python3 (>=3.11) + uv (or pip/venv)" \
        "  Go:      go (>=1.25)" \
        "OR — for the toolchain-free Go path — network access plus curl/wget," \
        "to download a prebuilt Go binary for this platform." \
        "" \
        "To pin a preferred runtime, write 'runtime=js' (or python, go) to" \
        "  $conf_file" >&2
    exit 127
}

# ---------------------------------------------------------------------------
# PATH mode (standalone install: tokenmonitor-mcp-go / -py / -js already on PATH)
# ---------------------------------------------------------------------------

# Map an impl name to the binary the launcher invokes.
binary_for() {
    case "$1" in
        go)     echo "tokenmonitor-mcp-go" ;;
        python) echo "tokenmonitor-mcp-py" ;;
        js)     echo "tokenmonitor-mcp-js" ;;
    esac
}

path_run() {
    case "$runtime" in
        auto)   order="go python js" ;;
        go)     order="go python js" ;;
        python) order="python go js" ;;
        js)     order="js go python"  ;;
    esac

    # The version this launcher was shipped/vendored at, if a VERSION file
    # sits next to it (install.sh puts server/tokenmonitor-mcp + its VERSION on PATH).
    # Empty when there is nothing to compare against.
    _want_ver=""
    [ -r "$script_dir/VERSION" ] && _want_ver=$(cat "$script_dir/VERSION" 2>/dev/null)

    # Try each candidate. Probe is short: --probe must answer in <2s.
    attempted=""
    for impl in $order; do
        bin=$(binary_for "$impl")
        # command -v silently fails when not on PATH.
        bin_path=$(command -v "$bin" 2>/dev/null || true)
        if [ -z "$bin_path" ]; then
            attempted="$attempted $impl(not-on-PATH)"
            continue
        fi
        # --probe reports "<runtime> <version>" on stderr (stdout stays
        # clean for JSON-RPC). Capture it so we can sanity-check the binary's
        # version against what this launcher expects — the standalone PATH
        # binary is the classic stale-binary footgun (it goes out of date
        # silently while the source moves on).
        _probe_out=$("$bin_path" --probe 2>&1 >/dev/null)
        _probe_rc=$?
        if [ "$_probe_rc" -eq 0 ]; then
            _got_ver=$(printf '%s\n' "$_probe_out" | awk 'NF{print $2; exit}')
            if [ -n "$_want_ver" ] && [ -n "$_got_ver" ] && \
               [ "$_got_ver" != "$_want_ver" ]; then
                log "WARNING: PATH binary $bin_path reports version '$_got_ver'"
                log "WARNING: but this launcher expects '$_want_ver' — the standalone"
                log "WARNING: $bin is STALE. Rebuild it from the bundled source, or"
                log "WARNING: remove it from PATH and use the plugin's bundle mode."
            fi
            printf 'tokenmonitor-mcp launcher: using %s (%s)\n' "$impl" "$bin_path" >&2
            exec "$bin_path" "$@"
        fi
        attempted="$attempted $impl(probe-failed)"
    done

    # No candidate worked. Tell the user how to install at least one.
    # Use printf (POSIX shell builtin) rather than cat so the diagnostic
    # still surfaces when PATH is empty (e.g. under `env -i`).
    printf '%s\n' \
        "tokenmonitor-mcp launcher: no working implementation found on PATH." \
        "Tried:$attempted" \
        "" \
        "The supported path is the tokenmonitor plugin, which bundles the" \
        "server and runs it directly (no PATH binary needed) — install the" \
        "plugin from the marketplace instead of using PATH mode." \
        "" \
        "If you really want a standalone PATH binary, build one from the" \
        "bundled source and put it on \$PATH, e.g.:" \
        "  Go:     (cd <plugin>/server/go && go build -o ~/.local/bin/tokenmonitor-mcp-go ./cmd/tokenmonitor-mcp)" \
        "  Python: pipx install <plugin>/server/py" \
        "  Node:   (cd <plugin>/server/js && npm install -g .)" \
        "" \
        "To pin a preferred runtime, write 'runtime=go' (or python, js) to" \
        "  $conf_file" >&2
    exit 127
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

if [ "$is_bundle" -eq 1 ]; then
    bundle_run "$@"
else
    path_run "$@"
fi
